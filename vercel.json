{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "backend/app.py"
    },
    {
      "src": "/api/templates",
      "dest": "backend/app.py"
    },
    {
      "src": "/api/preview",
      "dest": "backend/app.py"
    },
    {
      "src": "/api/generate",
      "dest": "backend/app.py"
    },
    {
      "src": "/api/download/(.*)",
      "dest": "backend/app.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
